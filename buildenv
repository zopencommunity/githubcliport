# bump: ghcli-version /GITHUB_CLI_VERSION="(.*)"/ https://github.com/cli/cli.git|semver:*
GITHUB_CLI_VERSION="2.102.0"

export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="development networking"
export ZOPEN_STABLE_TAG="v${GITHUB_CLI_VERSION}"
export ZOPEN_STABLE_URL="https://github.com/cli/cli.git"
export ZOPEN_STABLE_DEPS="check_go make wharf git coreutils"

export ZOPEN_DEV_URL="https://github.com/cli/cli.git"
export ZOPEN_DEV_DEPS="check_go make wharf git coreutils"
export ZOPEN_DEV_BRANCH="trunk"

export ZOPEN_RUNTIME_DEPS="git"

export ZOPEN_COMP=GO
export ZOPEN_CONFIGURE="zopen_wharf"
export ZOPEN_CONFIGURE_MINIMAL=1
export ZOPEN_MAKE="zopen_build"
export ZOPEN_MAKE_MINIMAL=1
export ZOPEN_CHECK="skip"
export ZOPEN_CLEAN="zopen_clean"

export ZOPEN_INSTALL_OPTS="install prefix=\$ZOPEN_INSTALL_DIR"

export ZOPEN_NAME="githubcli-${GITHUB_CLI_VERSION}"

clone_module()
{
  repo="$1"
  dir="$2"
  ref="$3"

  if [ ! -d "${dir}/.git" ]; then
    git clone "${repo}" "${dir}"
  fi

  git -C "${dir}" fetch --tags --force
  git -C "${dir}" checkout --force "${ref}"
  git -C "${dir}" clean -fdx
}

apply_port_patch()
{
  dir="$1"
  patch="$2"

  if ! git -C "${dir}" apply --check "../patches/${patch}"; then
    echo "Patch ${patch} did not apply cleanly in ${dir}; assuming it was already applied or needs refresh."
    git -C "${dir}" apply --reverse --check "../patches/${patch}" >/dev/null 2>&1 || return 1
    return 0
  fi

  git -C "${dir}" apply "../patches/${patch}"
}

zopen_init()
{
  export CGO_ENABLED=0
  # Go installs binaries, so create the bin dir as well
  export GOBIN=$ZOPEN_INSTALL_DIR/bin
  export PATH=$PATH:$GOROOT/go-build-zos/bin
  mkdir -p $ZOPEN_INSTALL_DIR
}

zopen_build()
{
  go build -o script/build script/build.go
  ./script/build
}

zopen_wharf()
{
  # When ZOPEN_CONFIGURE_MINIMAL=1, this function is called from inside the cli directory
  # So we need to work relative to the parent directory
  cd ..
  
  clone_module https://github.com/atotto/clipboard.git clipboard v0.1.4
  clone_module https://github.com/AlecAivazis/survey.git survey v2.3.7
  clone_module https://github.com/charmbracelet/ultraviolet.git ultraviolet main
  apply_port_patch clipboard clipboard-zos.gopatch || return 1
  apply_port_patch survey gopatch || return 1
  apply_port_patch ultraviolet ultraviolet.gopatch || return 1

  go work init ./cli ./clipboard ./survey ./ultraviolet
  wharf ./cli/...
  cd ./cli
}

zopen_append_to_env() {
  cat <<EOF
export SSL_CERT_FILE=\$PWD/cacert.pem
EOF
}

zopen_post_install()
{
  # Install a cacert.pem to be used (optionally) by the customer
  $MYDIR/zopen update-cacert -f $1
}

zopen_clean()
{
  rm -rf ../.wharf_cache ../go.work* ../wharf_port ../survey ../ultraviolet ../clipboard
}

zopen_get_version()
{
  ./bin/gh --version | head -1 | cut -f3 -d' ' | cut -d'-' -f1
}
