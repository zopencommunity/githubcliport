+	"golang.org/x/sys/unix"
 )
 
 func (n *SizeNotifier) start() error {
@@ -33,7 +33,7 @@ func (n *SizeNotifier) getWindowSize() (cells Size, pixels Size, err error) {
 	n.m.Lock()
 	defer n.m.Unlock()
 
-	winsize, err := termios.GetWinsize(int(n.f.Fd()))
+	winsize, err := unix.IoctlGetWinsize(int(n.f.Fd()), unix.TIOCGWINSZ)
 	if err != nil {
 		return Size{}, Size{}, err //nolint:wrapcheck
 	}
